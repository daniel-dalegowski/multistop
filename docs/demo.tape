# Records docs/demo.gif. Run from the repo root: go build && vhs docs/demo.tape
Output docs/demo.gif

Set Shell "bash"
Set FontSize 18
Set Width 1000
Set Height 280
Set Padding 20
Set TypingSpeed 40ms

Hide
Type "./multistop"
Enter
Sleep 500ms
Show

# Rename the default stopwatch and start it
Type "e"
Ctrl+U
Type "Getting the chickens out of the swamp"
Enter
Space
Sleep 1.5s

# Add a second stopwatch and start it
Type "n"
Type "Writing Don Quixote from scratch"
Enter
Space
Sleep 1.5s

# Add a third one, leave it stopped
Type "n"
Type "Swapping the final drive"
Enter
Sleep 1s

# Go back up and pause "Don Quixote"
Up
Sleep 500ms
Space
Sleep 2.5s

Hide
Type "q"
